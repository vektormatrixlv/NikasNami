    width:17px;height:17px;accent-color:var(--seal);margin-top:2px;
    flex-shrink:0;cursor:pointer;
  }
  @media(min-width:480px){.urgent-row input{width:18px;height:18px;}}
  .urgent-row .lbl{font-size:.8rem;font-weight:600;cursor:pointer;}
  .urgent-row .sub{
    font-size:.65rem;color:var(--slate);display:block;font-weight:400;
  }
  @media(min-width:480px){.urgent-row .lbl{font-size:.84rem;} .urgent-row .sub{font-size:.7rem;}}

  .delivery-grid{
    display:grid;grid-template-columns:1fr 1fr;gap:6px;
  }
  @media(min-width:480px){.delivery-grid{gap:8px;}}
  @media(min-width:768px){.delivery-grid{gap:10px;}}
  .del-opt{
    border:1px solid var(--line);border-radius:9px;padding:6px 8px;
    cursor:pointer;background:var(--paper);
