    font-size:.78rem;min-height:38px;
  }
  @media(min-width:480px){.del-opt{padding:8px 10px;font-size:.82rem;min-height:42px;gap:6px;}}
  @media(min-width:768px){.del-opt{padding:11px 13px;font-size:.86rem;min-height:44px;}}
  .del-opt input{margin-right:2px;accent-color:var(--seal);cursor:pointer;flex-shrink:0;}
  .del-opt .price{
    margin-left:auto;font-family:var(--mono);font-size:.65rem;color:var(--slate);
    white-space:nowrap;
  }
  @media(min-width:480px){.del-opt .price{font-size:.7rem;}}
  @media(min-width:768px){.del-opt .price{font-size:.72rem;}}
  .del-opt:has(input:checked){border-color:var(--seal);background:#FBF3EC;}
  #courierAddressWrap{display:none;margin-top:8px;}
  @media(min-width:480px){#courierAddressWrap{margin-top:10px;}}

  .price-panel{
    margin-top:16px;padding:14px 16px;border-radius:11px;
    background:var(--ink);color:var(--paper);
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    flex-wrap:wrap;
  }
  @media(min-width:480px){.price-panel{padding:16px 18px;margin-top:18px;gap:12px;}}
  @media(min-width:768px){.price-panel{padding:20px 22px;margin-top:22px;gap:16px;}}
  .price-panel .lbl{
    font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;
    color:#C9CEDA;font-family:var(--mono);
  }
  @media(min-width:480px){.price-panel .lbl{font-size:.7rem;}}
  .price-panel .amount{
    font-family:var(--mono);font-size:1.3rem;font-weight:600;
  }
  @media(min-width:480px){.price-panel .amount{font-size:1.5rem;}}
  @media(min-width:768px){.price-panel .amount{font-size:1.9rem;}}
  .price-panel .amount span{font-size:.75rem;opacity:.7;}
  @media(min-width:480px){.price-panel .amount span{font-size:.85rem;}}
  @media(min-width:768px){.price-panel .amount span{font-size:1rem;}}
  .price-panel.stamped{animation:stampfx .35s ease;}
  @keyframes stampfx{
    0%{transform:scale(1);}
    35%{transform:scale(1.035) rotate(-.6deg);}
    60%{transform:scale(.99) rotate(.3deg);}
    100%{transform:scale(1) rotate(0);}
  }
  @media (prefers-reduced-motion: reduce){
    .price-panel.stamped{animation:none;}
    html{scroll-behavior:auto;}
  }

  /* ---------- Order form ---------- */
  #orderForm{display:none;margin-top:14px;}
  #orderForm.open{display:block;}
  .form-grid{
    display:grid;grid-template-columns:1fr;gap:10px;
  }
  @media(min-width:480px){.form-grid{grid-template-columns:1fr 1fr;gap:12px;}}
  @media(min-width:768px){.form-grid{gap:14px;}}
