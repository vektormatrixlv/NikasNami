<!DOCTYPE html>
<html lang="lv">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>Nikas Nami+ — Dokumentu tulkošana un legalizācija</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B2A3D;
    --ink-soft:#2E3B4E;
    --paper:#F6F1E7;
    --paper-2:#EFE7D6;
    --seal:#9C3B2E;
    --seal-dark:#7C2E24;
    --gold:#AD8A4E;
    --slate:#5B6474;
    --line: rgba(27,42,61,0.14);
    --card: #FFFEFB;
    --shadow: 0 20px 45px -25px rgba(27,42,61,0.35);
    --radius: 14px;
    --serif: 'Fraunces', serif;
    --sans: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
    --header-height: 64px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    overflow-x:hidden;
  }
  img,svg{display:block;max-width:100%;height:auto;}
  a{color:inherit;text-decoration:none;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;}
  h1,h2,h3,h4{font-family:var(--serif);margin:0 0 .4em;font-weight:600;letter-spacing:-0.01em;line-height:1.2;}
  p{margin:0 0 1em;color:var(--slate);}
  .mono{font-family:var(--mono);}
  .wrap{max-width:1160px;margin:0 auto;padding:0 16px;}
  @media(min-width:480px){.wrap{padding:0 20px;}}
  @media(min-width:768px){.wrap{padding:0 28px;}}
  section{padding:48px 0;}
  @media(min-width:480px){section{padding:60px 0;}}
  @media(min-width:768px){section{padding:96px 0;}}
  .eyebrow{
    font-family:var(--mono);
    font-size:.65rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--seal);
    display:flex;align-items:center;gap:8px;
    margin-bottom:10px;
  }
  @media(min-width:480px){.eyebrow{font-size:.7rem;gap:10px;margin-bottom:12px;}}
  .eyebrow::before{content:"";width:18px;height:1px;background:var(--seal);flex-shrink:0;}
  @media(min-width:480px){.eyebrow::before{width:22px;}}
  :focus-visible{outline:2px solid var(--seal);outline-offset:3px;border-radius:4px;}

  /* ---------- Wax seal signature element ---------- */
  .stamp{
    --sz: 56px;
    width:var(--sz);height:var(--sz);border-radius:50%;
    position:relative;flex-shrink:0;
    background:
      radial-gradient(circle at 32% 28%, rgba(255,255,255,.18), transparent 40%),
      conic-gradient(from 90deg, var(--seal), var(--seal-dark), var(--seal));
    box-shadow: 0 6px 14px -6px rgba(156,59,46,.6), inset 0 0 0 2px rgba(255,255,255,.15);
    display:flex;align-items:center;justify-content:center;
  }
  @media(min-width:480px){.stamp{--sz:64px;}}
  .stamp::before{
    content:"";position:absolute;inset:5px;border-radius:50%;
    border:1.5px dashed rgba(255,255,255,.55);
  }
  @media(min-width:480px){.stamp::before{inset:6px;}}
  .stamp svg{width:46%;height:46%;fill:none;stroke:#F6F1E7;stroke-width:1.6;}

  /* ========== HEADER ========== */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(246,241,231,.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom:1px solid var(--line);
    min-height:var(--header-height);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:10px 0;gap:8px;
    min-height:var(--header-height);
  }
  @media(min-width:480px){.nav{padding:12px 0;gap:12px;}}
  @media(min-width:768px){.nav{padding:16px 0;}}

  /* Brand */
  .brand{
    display:flex;align-items:center;gap:8px;
    font-family:var(--serif);font-size:.9rem;font-weight:600;
    flex-shrink:0;
  }
  @media(min-width:480px){.brand{font-size:1rem;gap:10px;}}
  @media(min-width:768px){.brand{font-size:1.15rem;gap:12px;}}
  .brand .mark{
    width:28px;height:28px;border-radius:50%;background:var(--ink);
    position:relative;flex-shrink:0;
  }
  @media(min-width:480px){.brand .mark{width:32px;height:32px;}}
  @media(min-width:768px){.brand .mark{width:34px;height:34px;}}
  .brand .mark::after{
    content:"N";color:var(--paper);font-family:var(--serif);
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-size:.75rem;
  }
  @media(min-width:480px){.brand .mark::after{font-size:.85rem;}}
  @media(min-width:768px){.brand .mark::after{font-size:.95rem;}}

  /* Navigation links - desktop */
  nav.links{
    display:none;gap:20px;font-size:.85rem;
  }
  @media(min-width:768px){nav.links{display:flex;gap:24px;font-size:.9rem;}}
  nav.links a{
    color:var(--ink-soft);position:relative;padding:4px 0;
    transition:color .2s;
    white-space:nowrap;
  }
  nav.links a:hover{color:var(--seal);}
  nav.links a::after{
    content:'';position:absolute;bottom:-2px;left:0;right:0;height:2px;
    background:var(--seal);transform:scaleX(0);transition:transform .25s;
  }
  nav.links a:hover::after{transform:scaleX(1);}

  /* Right side - language + CTA + menu toggle */
  .nav-right{
    display:flex;align-items:center;gap:6px;flex-shrink:0;
  }
  @media(min-width:480px){.nav-right{gap:10px;}}
  @media(min-width:768px){.nav-right{gap:16px;}}

  /* Language switcher */
  .lang-switch{
    display:flex;gap:2px;background:var(--paper-2);border-radius:999px;padding:2px;
    font-family:var(--mono);font-size:.6rem;
  }
  @media(min-width:480px){.lang-switch{font-size:.65rem;padding:3px;}}
  @media(min-width:768px){.lang-switch{font-size:.72rem;}}
  .lang-switch button{
    padding:4px 6px;border-radius:999px;color:var(--slate);
    transition:background .2s, color .2s;
    font-size:inherit;min-height:28px;
  }
  @media(min-width:480px){.lang-switch button{padding:5px 8px;min-height:32px;}}
  @media(min-width:768px){.lang-switch button{padding:6px 11px;min-height:36px;}}
  .lang-switch button.active{background:var(--ink);color:var(--paper);}
  .lang-switch button:hover:not(.active){background:rgba(27,42,61,.08);}

  /* CTA button in header */
  .btn-header{
    display:none;
    padding:6px 12px;border-radius:999px;border:1px solid var(--seal);
    background:var(--seal);color:var(--paper);font-weight:600;font-size:.7rem;
    cursor:pointer;text-decoration:none;transition:all .2s;
    white-space:nowrap;min-height:32px;
  }
  @media(min-width:480px){.btn-header{display:inline-flex;align-items:center;padding:8px 16px;font-size:.75rem;min-height:36px;}}
  @media(min-width:768px){.btn-header{padding:10px 20px;font-size:.85rem;min-height:40px;}}
  .btn-header:hover{background:var(--seal-dark);border-color:var(--seal-dark);transform:translateY(-1px);box-shadow:var(--shadow);}
  .btn-header:active{transform:translateY(0);}

  /* Mobile menu toggle - hamburger */
  .menu-toggle{
    display:flex;flex-direction:column;gap:3px;padding:4px;
    background:none;border:none;cursor:pointer;
    width:28px;height:28px;justify-content:center;align-items:center;
    flex-shrink:0;
  }
  @media(min-width:480px){.menu-toggle{width:32px;height:32px;gap:4px;padding:6px;}}
  @media(min-width:768px){.menu-toggle{display:none;}}
  .menu-toggle span{
    display:block;width:20px;height:2px;background:var(--ink);
    border-radius:2px;transition:all .25s;
  }
  @media(min-width:480px){.menu-toggle span{width:24px;height:2.5px;}}
  .menu-toggle.active span:nth-child(1){transform:rotate(45deg) translate(4px,4px);}
  .menu-toggle.active span:nth-child(2){opacity:0;}
  .menu-toggle.active span:nth-child(3){transform:rotate(-45deg) translate(4px,-4px);}

  /* Mobile navigation overlay */
  .mobile-nav-overlay{
    display:none;position:fixed;top:var(--header-height);left:0;right:0;
    background:rgba(246,241,231,.98);backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    padding:20px 16px;border-bottom:1px solid var(--line);
    box-shadow:0 20px 40px -20px rgba(27,42,61,.25);
    z-index:49;flex-direction:column;gap:12px;
    max-height:calc(100vh - var(--header-height));
    overflow-y:auto;
  }
  .mobile-nav-overlay.open{display:flex;}
  .mobile-nav-overlay a{
    padding:12px 16px;border-radius:10px;font-size:1rem;font-weight:500;
    color:var(--ink-soft);transition:all .2s;
    border:1px solid transparent;
  }
  .mobile-nav-overlay a:hover,
  .mobile-nav-overlay a:focus{
    background:var(--paper-2);border-color:var(--line);color:var(--seal);
  }
  .mobile-nav-overlay .btn-mobile{
    display:flex;align-items:center;justify-content:center;
    padding:14px;border-radius:999px;background:var(--seal);
    color:var(--paper);font-weight:600;font-size:.95rem;
    margin-top:4px;border:1px solid var(--seal);
    transition:all .2s;
  }
  .mobile-nav-overlay .btn-mobile:hover{background:var(--seal-dark);}

  /* ---------- Hero ---------- */
  .hero{padding:32px 0 24px;}
  @media(min-width:480px){.hero{padding:40px 0 32px;}}
  @media(min-width:768px){.hero{padding:72px 0 40px;}}
  .hero-top{
    display:grid;grid-template-columns:1fr;gap:32px;align-items:start;
  }
  @media(min-width:768px){.hero-top{gap:40px;}}
  @media(min-width:992px){.hero-top{grid-template-columns:1.05fr .95fr;gap:56px;}}
  .hero h1{
    font-size:clamp(1.6rem, 4.5vw, 3.4rem);
    line-height:1.08;max-width:14ch;
  }
  @media(min-width:480px){.hero h1{font-size:clamp(1.8rem, 5vw, 3.4rem);}}
  .hero-lede{font-size:.95rem;max-width:46ch;}
  @media(min-width:480px){.hero-lede{font-size:1rem;}}
  @media(min-width:768px){.hero-lede{font-size:1.08rem;}}
  .hero-advantages{
    display:grid;grid-template-columns:1fr;gap:12px;margin-top:20px;
  }
  @media(min-width:480px){.hero-advantages{grid-template-columns:1fr 1fr;gap:14px;margin-top:24px;}}
  @media(min-width:768px){.hero-advantages{gap:18px;margin-top:34px;}}
  .adv{display:flex;gap:10px;align-items:flex-start;}
  .adv .dot{
    width:7px;height:7px;border-radius:50%;background:var(--gold);
    margin-top:5px;flex-shrink:0;
  }
  @media(min-width:480px){.adv .dot{width:8px;height:8px;margin-top:6px;}}
  .adv strong{display:block;font-size:.85rem;color:var(--ink);}
  .adv span{font-size:.78rem;color:var(--slate);}
  @media(min-width:480px){.adv strong{font-size:.9rem;} .adv span{font-size:.82rem;}}

  /* ---------- Calculator card ---------- */
  .calc-card{
    background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);
    border:1px solid var(--line);overflow:hidden;width:100%;
  }
  .calc-head{
    padding:14px 16px;background:var(--ink);color:var(--paper);
    display:flex;align-items:center;justify-content:space-between;
    gap:10px;
  }
  @media(min-width:480px){.calc-head{padding:16px 20px;}}
  @media(min-width:768px){.calc-head{padding:22px 26px;}}
  .calc-head h3{color:var(--paper);margin:0;font-size:.9rem;}
  @media(min-width:480px){.calc-head h3{font-size:.95rem;}}
  @media(min-width:768px){.calc-head h3{font-size:1.05rem;}}
  .calc-head .stamp{--sz:32px;}
  @media(min-width:480px){.calc-head .stamp{--sz:36px;}}
  @media(min-width:768px){.calc-head .stamp{--sz:40px;}}
  .calc-body{padding:14px;}
  @media(min-width:480px){.calc-body{padding:16px;}}
  @media(min-width:768px){.calc-body{padding:26px;}}
  .field-row{
    display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:14px;
  }
  @media(min-width:480px){.field-row{grid-template-columns:1fr auto 1fr;gap:12px;align-items:end;margin-bottom:16px;}}
  @media(min-width:768px){.field-row{gap:14px;margin-bottom:18px;}}
  .field label{
    display:block;font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;
    color:var(--slate);margin-bottom:3px;font-family:var(--mono);
  }
  @media(min-width:480px){.field label{font-size:.7rem;margin-bottom:4px;}}
  @media(min-width:768px){.field label{font-size:.74rem;margin-bottom:6px;}}
  select, input[type=text], input[type=email], input[type=tel], input[type=number]{
    width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--line);
    background:var(--paper);font-family:var(--sans);font-size:.85rem;color:var(--ink);
    transition:border-color .2s, box-shadow .2s;
    -webkit-appearance:none;appearance:none;
    min-height:40px;
  }
  @media(min-width:480px){select, input[type=text], input[type=email], input[type=tel], input[type=number]{
    padding:10px 12px;font-size:.88rem;min-height:44px;
  }}
  @media(min-width:768px){select, input[type=text], input[type=email], input[type=tel], input[type=number]{
    font-size:.92rem;padding:11px 12px;
  }}
  select:focus,input:focus{
    border-color:var(--seal);
    box-shadow:0 0 0 3px rgba(156,59,46,.1);
    outline:none;
  }
  .swap-btn{
    align-self:center;justify-self:center;margin:2px 0;
    width:36px;height:36px;border-radius:50%;border:1px solid var(--line);
    background:var(--paper);display:flex;align-items:center;justify-content:center;
    cursor:pointer;color:var(--slate);transition:all .2s;
    font-size:1.1rem;flex-shrink:0;
  }
  @media(min-width:480px){.swap-btn{width:38px;height:38px;font-size:1.2rem;align-self:end;margin-bottom:12px;}}
  @media(min-width:768px){.swap-btn{width:38px;height:38px;font-size:1rem;margin-bottom:18px;}}
  .swap-btn:hover{color:var(--seal);border-color:var(--seal);background:var(--paper-2);}

  .dropzone{
    border:1.5px dashed var(--line);border-radius:10px;padding:14px;text-align:center;
    background:var(--paper-2);cursor:pointer;transition:border-color .2s, background .2s;
    margin-bottom:14px;
  }
  @media(min-width:480px){.dropzone{padding:16px;margin-bottom:16px;}}
  @media(min-width:768px){.dropzone{padding:22px;margin-bottom:18px;}}
  .dropzone.drag{border-color:var(--seal);background:#F3E9DE;}
  .dropzone svg{width:22px;height:22px;margin:0 auto 5px;stroke:var(--slate);fill:none;stroke-width:1.5;}
  @media(min-width:480px){.dropzone svg{width:24px;height:24px;margin:0 auto 6px;}}
  @media(min-width:768px){.dropzone svg{width:26px;height:26px;margin:0 auto 8px;}}
  .dropzone p{margin:0;font-size:.78rem;}
  @media(min-width:480px){.dropzone p{font-size:.82rem;}}
  @media(min-width:768px){.dropzone p{font-size:.86rem;}}
  .dropzone .hint{font-size:.65rem;color:var(--slate);opacity:.8;display:block;margin-top:3px;}
  @media(min-width:480px){.dropzone .hint{font-size:.7rem;margin-top:4px;}}
  @media(min-width:768px){.dropzone .hint{font-size:.74rem;}}
  #fileInput{display:none;}
  .file-list{display:flex;flex-direction:column;gap:5px;margin-bottom:14px;}
  @media(min-width:480px){.file-list{gap:6px;margin-bottom:16px;}}
  @media(min-width:768px){.file-list{margin-bottom:18px;}}
  .file-item{
    display:flex;align-items:center;justify-content:space-between;font-size:.74rem;
    background:var(--paper);border:1px solid var(--line);border-radius:7px;padding:5px 8px;
    gap:6px;flex-wrap:wrap;
  }
  @media(min-width:480px){.file-item{font-size:.78rem;padding:6px 10px;}}
  @media(min-width:768px){.file-item{font-size:.82rem;padding:8px 11px;}}
  .file-item .name{
    font-family:var(--mono);font-size:.68rem;overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:50px;
  }
  @media(min-width:480px){.file-item .name{font-size:.72rem;min-width:60px;}}
  @media(min-width:768px){.file-item .name{font-size:.78rem;}}
  .file-item button{
    background:none;border:none;color:var(--seal);cursor:pointer;
    font-size:.8rem;padding:3px 5px;border-radius:4px;
    transition:background .2s;flex-shrink:0;
  }
  .file-item button:hover{background:rgba(156,59,46,.1);}

  .stepper-row{
    display:flex;flex-direction:column;gap:10px;margin-bottom:14px;
  }
  @media(min-width:480px){.stepper-row{flex-direction:row;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;}}
  @media(min-width:768px){.stepper-row{gap:16px;margin-bottom:18px;}}
  .stepper-row .field{width:100%;}
  @media(min-width:480px){.stepper-row .field{width:auto;margin:0;}}
  .stepper{
    display:flex;align-items:center;border:1px solid var(--line);border-radius:8px;
    overflow:hidden;width:fit-content;
  }
  .stepper button{
    width:32px;height:34px;border:none;background:var(--paper);
    color:var(--ink);font-size:1rem;cursor:pointer;
    transition:background .2s;flex-shrink:0;
  }
  @media(min-width:480px){.stepper button{width:36px;height:38px;font-size:1.1rem;}}
  @media(min-width:768px){.stepper button{width:38px;height:40px;}}
  .stepper button:hover{background:var(--paper-2);}
  .stepper button:active{background:var(--line);}
  .stepper input{
    width:42px;text-align:center;border:none;
    border-left:1px solid var(--line);border-right:1px solid var(--line);
    height:34px;font-family:var(--mono);font-size:.85rem;
    background:var(--paper);padding:0;
  }
  @media(min-width:480px){.stepper input{width:48px;height:38px;font-size:.9rem;}}
  @media(min-width:768px){.stepper input{width:56px;height:40px;font-size:.95rem;}}
  .stepper-row .note{
    font-size:.65rem;color:var(--slate);max-width:100%;
  }
  @media(min-width:480px){.stepper-row .note{font-size:.7rem;max-width:180px;}}
  @media(min-width:768px){.stepper-row .note{font-size:.78rem;}}

  fieldset{border:none;padding:0;margin:0 0 14px;}
  @media(min-width:480px){fieldset{margin:0 0 16px;}}
  @media(min-width:768px){fieldset{margin:0 0 18px;}}
  legend{
    font-size:.65rem;letter-spacing:.05em;text-transform:uppercase;
    color:var(--slate);font-family:var(--mono);margin-bottom:6px;padding:0;
  }
  @media(min-width:480px){legend{font-size:.7rem;margin-bottom:8px;}}
  @media(min-width:768px){legend{font-size:.74rem;margin-bottom:10px;}}
  .stamp-options{
    display:grid;grid-template-columns:1fr;gap:6px;
  }
  @media(min-width:480px){.stamp-options{grid-template-columns:1fr 1fr;gap:8px;}}
  @media(min-width:768px){.stamp-options{gap:10px;}}
  .stamp-opt{
    position:relative;border:1px solid var(--line);border-radius:9px;
    padding:8px 8px 8px 30px;cursor:pointer;background:var(--paper);
    transition:border-color .2s, background .2s;
    min-height:40px;display:flex;flex-direction:column;justify-content:center;
  }
  @media(min-width:480px){.stamp-opt{padding:10px 10px 10px 34px;min-height:44px;}}
  @media(min-width:768px){.stamp-opt{padding:12px 12px 12px 40px;min-height:48px;}}
  .stamp-opt input{position:absolute;opacity:0;}
  .stamp-opt .mini-seal{
    position:absolute;left:8px;top:50%;transform:translateY(-50%);
    width:14px;height:14px;border-radius:50%;border:1.5px solid var(--slate);
    transition:all .2s;flex-shrink:0;
  }
  @media(min-width:480px){.stamp-opt .mini-seal{width:16px;height:16px;left:10px;}}
  @media(min-width:768px){.stamp-opt .mini-seal{width:18px;height:18px;left:11px;}}
  .stamp-opt .lbl{display:block;font-size:.78rem;font-weight:600;}
  .stamp-opt .add{display:block;font-size:.65rem;color:var(--slate);font-family:var(--mono);}
  @media(min-width:480px){.stamp-opt .lbl{font-size:.82rem;} .stamp-opt .add{font-size:.7rem;}}
  .stamp-opt:has(input:checked){
    border-color:var(--seal);background:#FBF3EC;
  }
  .stamp-opt:has(input:checked) .mini-seal{
    background:var(--seal);border-color:var(--seal);
    box-shadow:0 0 0 3px rgba(156,59,46,.15);
  }
  .stamp-opt:hover:not(:has(input:checked)){border-color:var(--ink-soft);}

  .urgent-row{
    display:flex;align-items:flex-start;gap:10px;
    padding:10px 12px;border-radius:9px;background:var(--paper-2);
    margin-bottom:14px;cursor:pointer;
  }
  @media(min-width:480px){.urgent-row{padding:12px 14px;margin-bottom:16px;gap:12px;}}
  @media(min-width:768px){.urgent-row{margin-bottom:18px;}}
