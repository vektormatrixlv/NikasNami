<script>
(function(){
  // language rates (EUR per page, base tier — used to build the pair tariff)
  const LANGS = [
    ["lv","Latviešu",12], ["ru","Krievu",14], ["en","Angļu",15], ["de","Vācu",18],
    ["fr","Franču",20], ["es","Spāņu",20], ["it","Itāļu",20], ["lt","Lietuviešu",16],
    ["et","Igauņu",18], ["pl","Poļu",16], ["uk","Ukraiņu",15], ["sv","Zviedru",22],
    ["no","Norvēģu",24], ["fi","Somu",24], ["da","Dāņu",22], ["pt","Portugāļu",22],
    ["zh","Ķīniešu",30], ["ar","Arābu",30]
  ];
  const rateOf = code => (LANGS.find(l=>l[0]===code) || [,,15])[2];

  const fromSel = document.getElementById('fromLang');
  const toSel = document.getElementById('toLang');
  LANGS.forEach(([code,name])=>{
    fromSel.insertAdjacentHTML('beforeend', `<option value="${code}">${name}</option>`);
    toSel.insertAdjacentHTML('beforeend', `<option value="${code}">${name}</option>`);
  });
  fromSel.value = 'lv'; toSel.value = 'en';

  document.getElementById('swapBtn').addEventListener('click', ()=>{
    const a = fromSel.value; fromSel.value = toSel.value; toSel.value = a; recalc();
  });

  // language pill list
  const pillWrap = document.getElementById('langPills');
  LANGS.forEach(([,name])=> pillWrap.insertAdjacentHTML('beforeend', `<span class="lang-pill">${name}</span>`));

  // page stepper
  const pageInput = document.getElementById('pageCount');
  document.getElementById('pageMinus').addEventListener('click', ()=>{
    pageInput.value = Math.max(1, (parseInt(pageInput.value)||1) - 1); recalc();
  });
  document.getElementById('pagePlus').addEventListener('click', ()=>{
    pageInput.value = Math.min(500, (parseInt(pageInput.value)||1) + 1); recalc();
  });
  pageInput.addEventListener('input', ()=>{
    pageInput.value = pageInput.value.replace(/[^0-9]/g,'');
    if(pageInput.value === '') pageInput.value = '1';
    recalc();
  });

  // file dropzone
  const dz = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const fileListEl = document.getElementById('fileList');
  let files = [];
  const MAX_FILES = 10, MAX_MB = 30;

  dz.addEventListener('click', ()=> fileInput.click());
  dz.addEventListener('keydown', e=>{ if(e.key==='Enter' || e.key===' ') {e.preventDefault(); fileInput.click();} });
  ['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e=>{ e.preventDefault(); dz.classList.add('drag'); }));
  ['dragleave','drop'].forEach(ev => dz.addEventListener(ev, e=>{ e.preventDefault(); dz.classList.remove('drag'); }));
  dz.addEventListener('drop', e=> addFiles(e.dataTransfer.files));
  fileInput.addEventListener('change', e=> addFiles(e.target.files));

  function addFiles(list){
    Array.from(list).forEach(f=>{
      if(files.length >= MAX_FILES) return;
      if(f.size > MAX_MB*1024*1024) return;
      files.push(f);
    });
    renderFiles();
  }
  function renderFiles(){
    fileListEl.innerHTML = '';
    files.forEach((f,i)=>{
      const mb = (f.size/1024/1024).toFixed(1);
      fileListEl.insertAdjacentHTML('beforeend',
        `<div class="file-item"><span class="name">${f.name}</span><span>${mb} MB <button data-i="${i}" type="button" aria-label="Noņemt failu">✕</button></span></div>`);
    });
    fileListEl.querySelectorAll('button').forEach(b=>{
      b.addEventListener('click', ()=>{ files.splice(parseInt(b.dataset.i),1); renderFiles(); });
    });
  }

  // courier address reveal
  const courierRadio = document.querySelector('#courierOpt input');
  const courierWrap = document.getElementById('courierAddressWrap');
  document.querySelectorAll('input[name=delivery]').forEach(r=>{
    r.addEventListener('change', ()=>{
      courierWrap.style.display = courierRadio.checked ? 'block' : 'none';
      recalc();
    });
  });

  document.querySelectorAll('input[name=cert]').forEach(r=> r.addEventListener('change', recalc));
  document.getElementById('urgentCheck').addEventListener('change', recalc);
  fromSel.addEventListener('change', recalc);
  toSel.addEventListener('change', recalc);

  const pricePanel = document.getElementById('pricePanel');
  const totalPriceEl = document.getElementById('totalPrice');
  const payAmountEl = document.getElementById('payAmount');

  function currentTotal(){
    const pages = Math.max(1, parseInt(pageInput.value)||1);
    const rate = Math.max(rateOf(fromSel.value), rateOf(toSel.value));
    const cert = parseFloat(document.querySelector('input[name=cert]:checked').value);
    const urgent = document.getElementById('urgentCheck').checked;
    const delivery = parseFloat(document.querySelector('input[name=delivery]:checked').value);
    let base = rate * pages + cert;
    if(urgent) base *= 1.5;
    return +(base + delivery).toFixed(2);
  }

  function recalc(){
    const total = currentTotal();
    const formatted = total.toFixed(2).replace('.', ',');
    totalPriceEl.textContent = formatted;
    payAmountEl.textContent = formatted + ' €';
    pricePanel.classList.remove('stamped');
    void pricePanel.offsetWidth;
    pricePanel.classList.add('stamped');
  }
  recalc();

  // order form reveal
  const orderForm = document.getElementById('orderForm');
  document.getElementById('toOrderBtn').addEventListener('click', ()=>{
    orderForm.classList.add('open');
    setTimeout(()=>{
      orderForm.scrollIntoView({behavior:'smooth', block:'nearest'});
    }, 100);
  });

  // client type toggle
  const legalFields = document.getElementById('legalFields');
  const personPay = document.getElementById('personPay');
  const legalPay = document.getElementById('legalPay');
  document.querySelectorAll('input[name=clientType]').forEach(r=>{
    r.addEventListener('change', ()=>{
      const isLegal = document.querySelector('input[name=clientType]:checked').value === 'company';
      legalFields.style.display = isLegal ? 'grid' : 'none';
      personPay.style.display = isLegal ? 'none' : 'block';
      legalPay.style.display = isLegal ? 'block' : 'none';
    });
  });

  const confirmPanel = document.getElementById('confirmPanel');
  const confirmText = document.getElementById('confirmText');
  const orderIdEl = document.getElementById('orderId');

  function requireBaseFields(){
    const gdpr = document.getElementById('gdprCheck').checked;
    const name = document.getElementById('fname').value.trim();
    const email = document.getElementById('email').value.trim();
    if(!gdpr){ alert('Lūdzu, apstipriniet piekrišanu personas datu apstrādei.'); return false; }
    if(!name || !email){ alert('Lūdzu, aizpildiet vārdu un e-pastu.'); return false; }
    return true;
  }

  function fireConfirm(msg){
    const id = 'NN-' + Math.floor(2000 + Math.random()*7999);
    orderIdEl.textContent = '#' + id;
    confirmText.textContent = msg.replace('{id}', '#'+id);
    orderForm.classList.remove('open');
    confirmPanel.classList.add('show');
    setTimeout(()=>{
      confirmPanel.scrollIntoView({behavior:'smooth', block:'nearest'});
    }, 100);
  }

  document.getElementById('payBtn').addEventListener('click', ()=>{
    if(!requireBaseFields()) return;
    fireConfirm('Pasūtījums {id} apmaksāts. Dokumenti pieņemti darbā.');
  });
  document.getElementById('invoiceBtn').addEventListener('click', ()=>{
    if(!requireBaseFields()) return;
    fireConfirm('Pieprasījums {id} nosūtīts — rēķins tiks nosūtīts uz norādīto e-pastu.');
  });
  document.getElementById('newOrderBtn').addEventListener('click', ()=>{
    confirmPanel.classList.remove('show');
    const hero = document.getElementById('kalkulators');
    window.scrollTo({top: hero.offsetTop - 80, behavior:'smooth'});
  });

  // decorative language switch (visual only)
  document.querySelectorAll('.lang-switch').forEach(group=>{
    group.querySelectorAll('button').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        group.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
      });
    });
  });

  // Mobile menu toggle
  const menuToggle = document.getElementById('menuToggle');
  const mobileNav = document.getElementById('mobileNav');
  
  if(menuToggle && mobileNav){
    menuToggle.addEventListener('click', ()=>{
      const isOpen = menuToggle.classList.toggle('active');
      menuToggle.setAttribute('aria-expanded', isOpen);
      mobileNav.classList.toggle('open');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });
    
    // Close menu on link click
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', ()=>{
        menuToggle.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
        mobileNav.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
    
    // Close on resize to desktop
    window.addEventListener('resize', ()=>{
      if(window.innerWidth >= 768 && mobileNav.classList.contains('open')){
        menuToggle.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
        mobileNav.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  }
})();
</script>
</body>
</html>
