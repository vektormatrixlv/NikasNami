    display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px;
  }
  @media(min-width:480px){.type-toggle{gap:8px;margin-bottom:14px;}}
  @media(min-width:768px){.type-toggle{gap:10px;margin-bottom:16px;}}
  .type-toggle label{
    border:1px solid var(--line);border-radius:8px;padding:6px 8px;
    text-align:center;cursor:pointer;font-size:.78rem;
    transition:border-color .2s, background .2s;
    display:flex;align-items:center;justify-content:center;gap:4px;
  }
  @media(min-width:480px){.type-toggle label{padding:8px 10px;font-size:.82rem;gap:6px;}}
  @media(min-width:768px){.type-toggle label{padding:10px;font-size:.86rem;}}
  .type-toggle input{margin-right:2px;accent-color:var(--seal);cursor:pointer;}
  .type-toggle label:has(input:checked){border-color:var(--seal);background:#FBF3EC;}
  #legalFields{display:none;}
  .gdpr{
    display:flex;gap:8px;align-items:flex-start;
    margin:12px 0;font-size:.74rem;color:var(--slate);
  }
  @media(min-width:480px){.gdpr{font-size:.78rem;gap:10px;margin:14px 0;}}
  @media(min-width:768px){.gdpr{font-size:.82rem;margin:16px 0;}}
  .gdpr input{margin-top:2px;accent-color:var(--seal);flex-shrink:0;cursor:pointer;width:16px;height:16px;}
  .pay-methods{
    display:flex;flex-wrap:wrap;gap:4px;margin:10px 0;
  }
  @media(min-width:480px){.pay-methods{gap:6px;margin:12px 0;}}
  @media(min-width:768px){.pay-methods{gap:8px;margin:14px 0;}}
  .pay-methods span{
    font-family:var(--mono);font-size:.62rem;border:1px solid var(--line);
    border-radius:5px;padding:3px 6px;color:var(--slate);
    background:var(--paper);
  }
  @media(min-width:480px){.pay-methods span{font-size:.68rem;padding:4px 8px;}}
  @media(min-width:768px){.pay-methods span{font-size:.72rem;padding:5px 9px;}}
  .confirm-panel{
    display:none;text-align:center;padding:16px 10px;
  }
  @media(min-width:480px){.confirm-panel{padding:20px 12px;}}
  @media(min-width:768px){.confirm-panel{padding:30px 20px;}}
  .confirm-panel.show{display:block;}
  .confirm-panel .stamp{--sz:60px;margin:0 auto 12px;}
  @media(min-width:480px){.confirm-panel .stamp{--sz:68px;margin:0 auto 14px;}}
  @media(min-width:768px){.confirm-panel .stamp{--sz:78px;margin:0 auto 16px;}}
  .confirm-panel .oid{font-family:var(--mono);color:var(--seal);}

  /* ---------- Process ---------- */
  .process{background:var(--paper-2);}
  .process-grid{
    display:grid;grid-template-columns:1fr;gap:24px;margin-top:28px;
    position:relative;
  }
  @media(min-width:480px){.process-grid{gap:28px;margin-top:32px;}}
  @media(min-width:768px){.process-grid{gap:34px;margin-top:48px;}}
  @media(min-width:992px){.process-grid{grid-template-columns:repeat(3,1fr);}}
  .process-grid::before{
    content:"";position:absolute;top:28px;left:12%;right:12%;height:1px;
    background:repeating-linear-gradient(to right, var(--line) 0 8px, transparent 8px 16px);
    z-index:0;display:none;
  }
  @media(min-width:992px){.process-grid::before{display:block;}}
  .p-step{position:relative;z-index:1;}
  .p-step .stamp{margin-bottom:14px;}
  @media(min-width:480px){.p-step .stamp{margin-bottom:16px;}}
  @media(min-width:768px){.p-step .stamp{margin-bottom:20px;}}
  .p-step h4{font-size:1.05rem;}
  @media(min-width:480px){.p-step h4{font-size:1.1rem;}}
  @media(min-width:768px){.p-step h4{font-size:1.15rem;}}
  .p-num{font-family:var(--mono);font-size:.65rem;color:var(--seal);letter-spacing:.08em;}
  @media(min-width:480px){.p-num{font-size:.7rem;}}

  /* ---------- Languages/services ---------- */
  .langs{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px;}
  @media(min-width:480px){.langs{gap:8px;margin-top:20px;}}
  @media(min-width:768px){.langs{gap:10px;margin-top:28px;}}
  .lang-pill{
    border:1px solid var(--line);border-radius:999px;padding:5px 12px;
    font-size:.76rem;background:var(--card);
    transition:border-color .2s;
  }
  @media(min-width:480px){.lang-pill{padding:6px 14px;font-size:.8rem;}}
  @media(min-width:768px){.lang-pill{padding:8px 16px;font-size:.86rem;}}
  .lang-pill:hover{border-color:var(--seal);}
  .services-grid{
    display:grid;grid-template-columns:1fr;gap:12px;margin-top:24px;
  }
  @media(min-width:480px){.services-grid{grid-template-columns:1fr 1fr;gap:14px;margin-top:28px;}}
  @media(min-width:768px){.services-grid{gap:18px;margin-top:40px;}}
  @media(min-width:992px){.services-grid{grid-template-columns:repeat(4,1fr);}}
  .service-card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:14px;transition:box-shadow .2s, transform .2s;
  }
  @media(min-width:480px){.service-card{padding:16px;}}
  @media(min-width:768px){.service-card{padding:22px;}}
  .service-card:hover{box-shadow:var(--shadow);transform:translateY(-2px);}
  .service-card .stamp{--sz:36px;margin-bottom:10px;}
  @media(min-width:480px){.service-card .stamp{--sz:40px;margin-bottom:12px;}}
  @media(min-width:768px){.service-card .stamp{--sz:44px;margin-bottom:14px;}}
  .service-card h4{font-size:.9rem;margin-bottom:3px;}
  .service-card p{font-size:.78rem;margin:0;}
  @media(min-width:480px){.service-card h4{font-size:.95rem;margin-bottom:4px;} .service-card p{font-size:.82rem;}}
  @media(min-width:768px){.service-card p{font-size:.85rem;}}

  /* ---------- About / contact ---------- */
  .about-grid{
    display:grid;grid-template-columns:1fr;gap:28px;align-items:center;
  }
  @media(min-width:480px){.about-grid{gap:32px;}}
  @media(min-width:768px){.about-grid{grid-template-columns:1fr 1fr;gap:56px;}}
  .map-art{
    aspect-ratio:4/3;border-radius:var(--radius);background:var(--ink);
    position:relative;overflow:hidden;box-shadow:var(--shadow);
    width:100%;
  }
  .map-art svg{width:100%;height:100%;display:block;}
  .contact-list{list-style:none;padding:0;margin:16px 0;}
  @media(min-width:480px){.contact-list{margin:18px 0;}}
  @media(min-width:768px){.contact-list{margin:22px 0;}}
  .contact-list li{
    display:flex;flex-direction:column;gap:2px;padding:6px 0;
    border-bottom:1px solid var(--line);font-size:.84rem;
  }
  @media(min-width:480px){.contact-list li{flex-direction:row;gap:8px;padding:8px 0;font-size:.88rem;}}
  @media(min-width:768px){.contact-list li{gap:12px;padding:10px 0;font-size:.92rem;}}
  .contact-list li .k{
    color:var(--slate);font-family:var(--mono);font-size:.65rem;
    text-transform:uppercase;letter-spacing:.04em;padding-top:1px;
  }
  @media(min-width:480px){.contact-list li .k{font-size:.7rem;min-width:100px;}}
  @media(min-width:768px){.contact-list li .k{font-size:.78rem;min-width:120px;padding-top:2px;}}
  .msg-buttons{
    display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;
  }
  @media(min-width:480px){.msg-buttons{gap:8px;margin-top:14px;}}
  @media(min-width:768px){.msg-buttons{gap:10px;margin-top:18px;}}
  .msg-buttons a{
    display:flex;align-items:center;gap:4px;border:1px solid var(--line);
    border-radius:999px;padding:6px 12px;text-decoration:none;font-size:.78rem;
    color:var(--ink);transition:all .2s;
  }
  @media(min-width:480px){.msg-buttons a{padding:8px 14px;font-size:.82rem;gap:6px;}}
  @media(min-width:768px){.msg-buttons a{padding:9px 16px;font-size:.86rem;gap:8px;}}
  .msg-buttons a:hover{border-color:var(--seal);color:var(--seal);background:rgba(156,59,46,.04);}

  /* ---------- Cabinet mock ---------- */
  .cabinet{background:var(--ink);color:var(--paper);padding:40px 0;}
  @media(min-width:480px){.cabinet{padding:48px 0;}}
  @media(min-width:768px){.cabinet{padding:96px 0;}}
  .cabinet .eyebrow{color:var(--gold);}
  .cabinet .eyebrow::before{background:var(--gold);}
  .cabinet h2{color:var(--paper);}
  .cabinet p{color:#B7BECD;}
  .order-card{
    background:#26364A;border:1px solid rgba(255,255,255,.08);
    border-radius:var(--radius);padding:14px 16px;margin-top:20px;
  }
  @media(min-width:480px){.order-card{padding:16px 18px;margin-top:24px;}}
  @media(min-width:768px){.order-card{padding:22px 24px;margin-top:30px;}}
  .order-card .top{
    display:flex;flex-direction:column;gap:4px;margin-bottom:12px;
  }
  @media(min-width:480px){.order-card .top{gap:6px;margin-bottom:14px;}}
  @media(min-width:768px){.order-card .top{flex-direction:row;justify-content:space-between;align-items:baseline;margin-bottom:18px;}}
  .order-card .oid{font-family:var(--mono);color:var(--gold);font-size:.78rem;}
  @media(min-width:480px){.order-card .oid{font-size:.82rem;}}
  @media(min-width:768px){.order-card .oid{font-size:.9rem;}}
  .order-card .meta{font-size:.72rem;color:#9AA4B6;}
  @media(min-width:480px){.order-card .meta{font-size:.76rem;}}
  @media(min-width:768px){.order-card .meta{font-size:.82rem;}}
  .progress-track{display:flex;gap:3px;margin-top:4px;}
  .progress-track .seg{flex:1;height:4px;border-radius:3px;background:rgba(255,255,255,.12);}
  @media(min-width:480px){.progress-track .seg{height:5px;gap:4px;}}
  @media(min-width:768px){.progress-track .seg{height:6px;}}
  .progress-track .seg.done{background:var(--gold);}
  .progress-labels{
    display:flex;justify-content:space-between;
    font-size:.55rem;color:#8B94A6;margin-top:5px;font-family:var(--mono);
    flex-wrap:wrap;gap:3px;
  }
  @media(min-width:480px){.progress-labels{font-size:.6rem;margin-top:6px;gap:4px;}}
  @media(min-width:768px){.progress-labels{font-size:.68rem;margin-top:8px;}}
  .progress-labels span.active{color:var(--gold);}

  /* ========== FOOTER ========== */
  footer{
    padding:24px 0 20px;border-top:1px solid var(--line);
    background:var(--paper);
  }
  @media(min-width:480px){footer{padding:28px 0 24px;}}
  @media(min-width:768px){footer{padding:52px 0 40px;}}
  .foot-row{
    display:flex;flex-direction:column;gap:14px;align-items:center;
    text-align:center;
  }
  @media(min-width:480px){.foot-row{gap:16px;}}
  @media(min-width:600px){.foot-row{flex-direction:row;flex-wrap:wrap;justify-content:center;text-align:left;}}
  @media(min-width:768px){.foot-row{justify-content:space-between;gap:18px;}}
  .foot-row .brand{
    font-size:.85rem;gap:8px;
  }
  @media(min-width:480px){.foot-row .brand{font-size:.9rem;gap:10px;}}
  @media(min-width:768px){.foot-row .brand{font-size:1rem;}}
  .foot-row .brand .mark{
    width:24px;height:24px;
  }
  @media(min-width:480px){.foot-row .brand .mark{width:28px;height:28px;}}
  @media(min-width:768px){.foot-row .brand .mark{width:32px;height:32px;}}
  .foot-row .brand .mark::after{font-size:.65rem;}
  @media(min-width:480px){.foot-row .brand .mark::after{font-size:.75rem;}}
  @media(min-width:768px){.foot-row .brand .mark::after{font-size:.85rem;}}

  .foot-links{
    display:flex;flex-wrap:wrap;gap:12px;font-size:.75rem;color:var(--slate);
    justify-content:center;
  }
  @media(min-width:480px){.foot-links{gap:16px;font-size:.78rem;}}
  @media(min-width:768px){.foot-links{gap:22px;font-size:.85rem;}}
  .foot-links a{transition:color .2s;padding:4px 0;}
  .foot-links a:hover{color:var(--seal);}
  .foot-row .lang-switch{
    font-size:.58rem;padding:2px;
  }
  @media(min-width:480px){.foot-row .lang-switch{font-size:.62rem;padding:3px;}}
  @media(min-width:768px){.foot-row .lang-switch{font-size:.65rem;}}
  .foot-row .lang-switch button{
    padding:3px 5px;min-height:24px;
  }
  @media(min-width:480px){.foot-row .lang-switch button{padding:4px 7px;min-height:28px;}}
  @media(min-width:768px){.foot-row .lang-switch button{padding:5px 9px;min-height:32px;}}

  /* ---------- Utility ---------- */
  .text-center{text-align:center;}
  .mt-8{margin-top:8px;}
  .mt-16{margin-top:16px;}
  .w-full{width:100%;}
  .gap-8{gap:8px;}
  .flex-center{display:flex;align-items:center;justify-content:center;}

  /* ---------- Print ---------- */
  @media print{
    header{position:static;background:var(--paper);backdrop-filter:none;}
    .btn,.btn-header,.lang-switch,.menu-toggle,.mobile-nav-overlay{display:none !important;}
    .calc-card{box-shadow:none;border:1px solid #ccc;}
    .price-panel{background:#f0f0f0;color:#000;}
    .price-panel .lbl{color:#666;}
    section{padding:40px 0;page-break-inside:avoid;}
    .cabinet{background:#f5f5f5;color:#000;}
    .cabinet h2{color:#000;}
    .cabinet p{color:#444;}
    .order-card{background:#eee;border-color:#ccc;}
    .order-card .oid{color:#9C3B2E;}
    .progress-track .seg.done{background:#9C3B2E;}
    .progress-labels span.active{color:#9C3B2E;}
    footer{border-top-color:#ccc;}
  }
</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="brand"><span class="mark"></span> Nikas Nami<span style="color:var(--seal)">+</span></div>
    
    <nav class="links">
      <a href="#pakalpojumi">Pakalpojumi</a>
      <a href="#process">Kā tas notiek</a>
      <a href="#valodas">Valodas</a>
      <a href="#kontakti">Kontakti</a>
    </nav>
    
    <div class="nav-right">
      <div class="lang-switch" role="group" aria-label="Valodas versija">
        <button class="active" type="button" aria-label="Latviešu">LV</button>
        <button type="button" aria-label="Krievu">RU</button>
        <button type="button" aria-label="Angļu">EN</button>
      </div>
      <a href="#kalkulators" class="btn-header">Pasūtīt</a>
      <button class="menu-toggle" id="menuToggle" aria-label="Izvēlne" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  
  <!-- Mobile Navigation Overlay -->
  <div class="mobile-nav-overlay" id="mobileNav">
    <a href="#pakalpojumi">Pakalpojumi</a>
    <a href="#process">Kā tas notiek</a>
    <a href="#valodas">Valodas</a>
    <a href="#kontakti">Kontakti</a>
    <a href="#kalkulators" class="btn-mobile">Pasūtīt tulkojumu</a>
  </div>
</header>

<main>
  <!-- ============ HERO + CALCULATOR ============ -->
  <section class="hero" id="kalkulators">
    <div class="wrap hero-top">
      <div>
        <div class="eyebrow">Tulkošana · Apliecināšana · Apostille</div>
        <h1>Dokumenta ceļš no skenera līdz zīmogam — bez vizītes birojā.</h1>
        <p class="hero-lede">Augšupielādējiet dokumentu, izvēlieties valodu pāri un apliecinājuma veidu — precīzu cenu redzēsiet uzreiz, ekrānā, pirms vēl esat nospiedis "Pasūtīt".</p>
        <div class="hero-advantages">
          <div class="adv"><span class="dot"></span><div><strong>18+ valodas</strong><span>no latviešu līdz ķīniešu un arābu</span></div></div>
          <div class="adv"><span class="dot"></span><div><strong>Zvērināti tulkotāji</strong><span>notariāls apliecinājums un apostille</span></div></div>
          <div class="adv"><span class="dot"></span><div><strong>Piegāde jebkur</strong><span>Omniva, DPD, kurjers vai birojs</span></div></div>
          <div class="adv"><span class="dot"></span><div><strong>Steidzami 24h</strong><span>ja dokuments vajadzīgs jau rīt</span></div></div>
        </div>
      </div>

      <div class="calc-card">
        <div class="calc-head">
          <h3>Aprēķini cenu</h3>
          <div class="stamp" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v6l-2 2v8H8v-8L6 9V3z"/><path d="M9 3v6M15 3v6"/></svg></div>
        </div>
        <div class="calc-body">

